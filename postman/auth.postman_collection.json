      "name": "Logout without credentials",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/api/v1/auth/logout",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Authentication error', () => pm.expect(pm.response.json()).to.eql({ success: false, message: 'Not authorized' }));"
            ]
          }
        }
      ]
    }
  ]
}
