              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('Success envelope', () => pm.expect(body.success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject administrator registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{BASE_URL}}/api/v1/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Example\",\n  \"telephone\": \"0812345678\",\n  \"email\": \"{{RUN_EMAIL}}\",\n  \"password\": \"{{RUN_PASSWORD}}\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('Success envelope', () => pm.expect(body.success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Incorrect password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{BASE_URL}}/api/v1/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{RUN_EMAIL}}\",\n  \"password\": \"{{WRONG_PASSWORD}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('WRONG_PASSWORD', pm.collectionVariables.get('RUN_PASSWORD') === 'wrong-password' ? 'other-password' : 'wrong-password');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('Success envelope', () => pm.expect(body.success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/api/v1/auth/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('Success envelope', () => pm.expect(body.success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/api/v1/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid-token",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('Success envelope', () => pm.expect(body.success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/api/v1/auth/logout",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{TOKEN}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('COPIED_TOKEN', pm.collectionVariables.get('TOKEN'));",
              "pm.variables.set('TOKEN', pm.collectionVariables.get('TOKEN'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Empty success response', () => pm.expect(body).to.eql({ success: true, data: {} }));",
              "pm.test('No authentication cookies issued', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false));",
              "if (pm.response.code === 200 && body.success === true) {",
              "  pm.collectionVariables.set('TOKEN', '');",
              "  pm.variables.set('TOKEN', '');",
              "}",
              "pm.test('Saved client token cleared', () => pm.expect(pm.collectionVariables.get('TOKEN')).to.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user after logout",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/api/v1/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{TOKEN}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Client has no saved token', () => pm.expect(pm.collectionVariables.get('TOKEN')).to.eql(''));",
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Authentication error', () => pm.expect(pm.response.json()).to.eql({ success: false, message: 'Not authorized' }));"
            ]
          }
        }
      ]
    },
    {
      "name": "Copied unexpired token remains valid",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/api/v1/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{COPIED_TOKEN}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Success envelope', () => pm.expect(body.success).to.eql(true));",
              "pm.test('Same account', () => pm.expect(body.data.email).to.eql(pm.collectionVariables.get('RUN_EMAIL').trim().toLowerCase()));",
              "pm.test('Client token stays cleared', () => pm.expect(pm.collectionVariables.get('TOKEN')).to.eql(''));",
              "pm.variables.unset('COPIED_TOKEN');"
            ]
          }
        }
      ]
    },
