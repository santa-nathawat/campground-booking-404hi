              "pm.test('Success envelope', () => pm.expect(body.success).to.eql(false));",
              "pm.test('Only public error fields', () => pm.expect(Object.keys(body).sort()).to.eql(['message', 'success']));"
            ]
          }
        }
      ]
    },
